---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
---

<BaseLayout title="Contact" description={`Contact ${SITE.name} — have a project in mind? Let's create something.`}>
  <section
    class="mx-auto flex min-h-[70svh] max-w-6xl flex-col justify-center px-6 py-24"
    aria-label="Contact"
  >
    <h1 class="reveal font-display text-4xl font-medium tracking-tight sm:text-6xl">
      Have a project in mind?
    </h1>
    <p class="reveal font-display text-ink-soft mt-4 text-2xl sm:text-4xl">
      Let&rsquo;s create something.
    </p>

    <div class="reveal mt-10">
      <a
        href={`mailto:${SITE.email}`}
        class="bg-signal inline-flex items-center gap-2 rounded-full px-8 py-4 text-sm font-semibold text-white transition-transform duration-300 hover:scale-[1.03]"
      >
        {SITE.email}
      </a>
    </div>

    <div class="reveal mt-12 flex flex-wrap gap-x-8 gap-y-3">
      {
        SITE.social.map((link) => (
          <a
            href={link.href}
            class="text-ink-soft hover:text-signal text-sm transition-colors"
            rel="me"
          >
            {link.label} →
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
