---
import { SITE, NAV_LINKS } from '@/site.config';

const currentPath = Astro.url.pathname;
---

<header class="border-line bg-paper/85 sticky top-0 z-40 border-b backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a
      href="/"
      class="font-display text-lg font-bold tracking-tight"
      aria-label={`${SITE.name} home`}
    >
      {SITE.name.toUpperCase()}
    </a>

    <nav class="flex items-center gap-6 sm:gap-8" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const isActive =
            currentPath === link.href || currentPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'text-xs font-medium tracking-[0.18em] uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
