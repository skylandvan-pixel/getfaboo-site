---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, category, year, cover } = entry.data;
---

<a
  href={`/work/${entry.id}`}
  data-category={category}
  class="work-card group block"
>
  <div class="bg-surface overflow-hidden rounded-2xl">
    <div class="aspect-video overflow-hidden">
      <img
        src={cover}
        alt={title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
      />
    </div>
  </div>
  <div class="mt-5 flex items-baseline justify-between gap-4">
    <h3 class="font-display text-xl font-medium sm:text-2xl">{title}</h3>
  </div>
  <p class="text-ink-soft mt-1 font-mono text-xs tracking-[0.18em] uppercase">
    {category} · {year}
  </p>
</a>
